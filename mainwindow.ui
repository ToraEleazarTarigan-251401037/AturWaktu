<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Atur Waktu</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #f8f7fc;
}
QWidget#centralwidget {
    background-color: #f8f7fc;
}
QTabWidget::pane {
    border: none;
    background-color: #f8f7fc;
    border-radius: 16px;
}
QTabWidget::tab-bar {
    alignment: center;
}
QTabBar::tab {
    background-color: #ede9f8;
    color: #6b6880;
    font-family: &quot;Inter&quot;;
    font-size: 13px;
    padding: 8px 28px;
    margin: 2px 3px;
    border-radius: 10px;
    min-width: 100px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8c73f2, stop:1 #c099ff);
    color: #ffffff;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #ddd6f7;
    color: #3d3a52;
}
QListWidget {
    background-color: #ffffff;
    border: 1.5px solid #e0ddf0;
    border-radius: 12px;
    padding: 6px;
    font-family: &quot;Inter&quot;;
    font-size: 14px;
    color: #14121e;
    outline: none;
}
QListWidget::item {
    padding: 8px 10px;
    border-radius: 8px;
    margin: 2px 0px;
}
QListWidget::item:selected {
    background-color: #ede9f8;
    color: #14121e;
}
QListWidget::item:hover {
    background-color: #f3f0fb;
}
QTimeEdit {
    background-color: #ffffff;
    border: 1.5px solid #e0ddf0;
    border-radius: 10px;
    padding: 8px 12px;
    font-family: &quot;Inter&quot;;
    font-size: 16px;
    color: #14121e;
}
QTimeEdit::up-button, QTimeEdit::down-button {
    width: 18px;
    border-radius: 5px;
    background: #ede9f8;
}
QPushButton {
    border-radius: 10px;
    padding: 10px 20px;
    font-family: &quot;Inter&quot;;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#btnAddAlarm {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8c73f2, stop:1 #c099ff);
    color: #ffffff;
    border: none;
}
QPushButton#btnAddAlarm:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7a60e0, stop:1 #b088ee);
}
QPushButton#btnDeleteAlarm {
    background-color: #ede9f8;
    color: #8c73f2;
    border: 1.5px solid #c9bff5;
}
QPushButton#btnDeleteAlarm:hover {
    background-color: #ddd6f7;
}
QPushButton#btnStartSW, QPushButton#btnStartTimer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8c73f2, stop:1 #c099ff);
    color: #ffffff;
    border: none;
    min-width: 80px;
}
QPushButton#btnStartSW:hover, QPushButton#btnStartTimer:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7a60e0, stop:1 #b088ee);
}
QPushButton#btnResetSW, QPushButton#btnResetTimer {
    background-color: #ede9f8;
    color: #8c73f2;
    border: 1.5px solid #c9bff5;
    min-width: 80px;
}
QPushButton#btnResetSW:hover, QPushButton#btnResetTimer:hover {
    background-color: #ddd6f7;
}
QPushButton#btnLapSW {
    background-color: #fff0f6;
    color: #fa73a6;
    border: 1.5px solid #fac0d5;
    min-width: 80px;
}
QPushButton#btnLapSW:hover {
    background-color: #ffe4f0;
}
QPushButton#btnPreset5, QPushButton#btnPreset10, QPushButton#btnPreset15, QPushButton#btnPreset30 {
    background-color: #ede9f8;
    color: #8c73f2;
    border: 1.5px solid #c9bff5;
    padding: 6px 14px;
    min-width: 54px;
    border-radius: 18px;
}
QPushButton#btnPreset5:hover, QPushButton#btnPreset10:hover,
QPushButton#btnPreset15:hover, QPushButton#btnPreset30:hover {
    background-color: #ddd6f7;
}
QLabel#labelTitle {
    font-family: &quot;Inter&quot;;
    font-size: 22px;
    font-weight: bold;
    color: #14121e;
    letter-spacing: -0.3px;
}
QLabel#labelStopwatch {
    font-family: &quot;Inter&quot;;
    font-size: 52px;
    color: #14121e;
    letter-spacing: -1.5px;
}
QLabel#labelTimer {
    font-family: &quot;Inter&quot;;
    font-size: 52px;
    color: #14121e;
    letter-spacing: -1px;
}
QLabel#labelTimerRemaining {
    font-family: &quot;Inter&quot;;
    font-size: 11px;
    color: #a09eaa;
}
QLabel#labelSWHeader, QLabel#labelTimerHeader {
    font-family: &quot;Inter&quot;;
    font-size: 13px;
    color: #a09eaa;
    font-weight: bold;
    letter-spacing: 1.5px;
}
QFrame#divider {
    color: #e0ddf0;
}
   </string>
